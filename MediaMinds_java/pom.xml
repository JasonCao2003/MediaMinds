<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <groupId>com.xupt</groupId>
    <artifactId>MediaMinds</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>MediaMinds</name>
    <description>SpringCloudDemo 项目用于 Spring Cloud 微服务架构</description>
    <url>https://github.com/xupt/SpringCloudDemo</url>

    <licenses>
        <license>
            <name>Apache 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>JasonCao2003</id>
            <name>JasonCao</name>
            <email>JasonCao2003@qq.com</email>
        </developer>
    </developers>

    <modules>
        <module>gateway-service</module>
        <module>discovery-service</module>
        <module>auth-service</module>
        <module>demo-service</module>
        <module>music-service</module>
        <module>book-service</module>
        <module>video-service</module>
        <module>agent-service</module>
    </modules>

    <scm>
        <connection>scm:git:https://github.com/xupt/SpringCloudDemo.git</connection>
        <developerConnection>scm:git:https://github.com/xupt/SpringCloudDemo.git</developerConnection>
        <url>https://github.com/xupt/SpringCloudDemo</url>
    </scm>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2024.0.1</spring-cloud.version>
        <spring-boot.version>3.4.4</spring-boot.version>
        <mysql.version>8.2.0</mysql.version>
        <langchain4j.version>1.22.0</langchain4j.version>
        <lombok.version>1.18.34</lombok.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>

                    <!--
                      关闭增量编译（默认是 true）。
                      原因：Maven Compiler Plugin 的增量编译路径会复用 target/classes 里已有的
                      生成结果，而 Lombok 注解处理器仍会记录已生成的 getter/setter 签名，最终落盘的
                      Code 属性长度为 0，JVM 校验直接拒绝：

                          java.lang.ClassFormatError: Invalid method Code length 0
                              in class file com/xupt/agent/Config/AgentLlmProperties

                      症状是「只有部分 Lombok 类」无法加载，且只在 mvn install（不带 clean）之后出现，
                      非常隐蔽。关闭增量编译后每次都是全量编译，从根上消除该问题。
                    -->
                    <useIncrementalCompilation>false</useIncrementalCompilation>

                    <!--
                      JDK 17+ / MCP 3.12+ 推荐显式声明注解处理器路径，避免处理器从 classpath
                      被偶然拾取导致构建结果不确定。本项目只用 Lombok 一个处理器。
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>